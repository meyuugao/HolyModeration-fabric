# HolyModeration backend environment (alwaysdata)
# Copy values into the alwaysdata "Environment" panel for the holymoderation app.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Chat ID where launch notifications are sent (your DM with the bot, or a group)
TELEGRAM_CHAT_ID=1243529557

# Your Telegram user id (numeric). Only this account can press the buttons.
ADMIN_TG_ID=1243529557

# Public HTTPS URL where Telegram will deliver webhook updates.
WEBHOOK_URL=https://holymoderation.alwaysdata.net/tg/webhook

# Optional shared secret: Telegram echoes it in X-Telegram-Bot-Api-Secret-Token.
# Generate one via: curl "https://holymoderation.alwaysdata.net/tg/secret?admin=1243529557"
# Leave empty to disable the check (webhook stays public but still admin-gated by from.id).
WEBHOOK_SECRET=
